Algoritmo EdadEnDias
	Escribir "ingrese su edad: "
	Leer edad
	
	dias = edad * 365
	meses = edad * 12
	semanas = edad * 52
	
	Escribir "Su edad en meses es la siguiente: ", meses
	Escribir "Su edad en semanas es la siguiente: ", semanas
	Escribir "Su edad en dias es la siguiente: ", dias
FinAlgoritmo

